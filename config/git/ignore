*.class
*.dll
*.exe
*.o
*.so

# Archives. Better to commit the source than a compressed blob.
*.7z
*.jar
*.rar
*.zip
*.gz
*.bz2
*.xz
*.lzma
*.iso
*.tar

# Logs and local databases
*.log
*.sqlite
*.sqlite3

